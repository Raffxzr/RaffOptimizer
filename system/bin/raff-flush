#!/system/bin/sh

LOGFILE="/data/adb/raffoptimizer/run/flush.log"
mkdir -p /data/adb/raffoptimizer/run

mode="${1:-safe}"
bg_limit="${2:-4}"

get_mem_info() {
  awk '/MemTotal/ {total=$2} /MemAvailable/ {avail=$2} END {
    if (total>0) {
      used=total-avail;
      printf "%d MB Free / %d MB Total (%d%% Used)", avail/1024, total/1024, (used*100)/total
    }
  }' /proc/meminfo
}

show_toast() {
  local msg="$1"
  # Try ShowToast broadcast/activity if installed, plus cmd notification
  am startservice -n "com.android.showtoast/.ShowToastService" --es "text" "$msg" >/dev/null 2>&1 || true
  cmd notification post -S bigtext -t "RaffOptimizer" "raff_flush" "$msg" >/dev/null 2>&1 || true
}

native_flush() {
  local level="$1"
  sync
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
  echo 1 > /proc/sys/vm/compact_memory 2>/dev/null

  case "$level" in
    safe|1|flush)
      am kill-all >/dev/null 2>&1
      ;;
    aggressive|2|flush2)
      am kill-all >/dev/null 2>&1
      for pkg in $(pm list packages -3 2>/dev/null | cut -d: -f2); do
        case "$pkg" in
          com.topjohnwu.magisk|me.weishu.kernelsu|me.bmax.apatch|com.termux|com.dergoogler.mmrl*) continue ;;
          *) am force-stop "$pkg" >/dev/null 2>&1 ;;
        esac
      done
      ;;
    extreme|3|flush3)
      am kill-all >/dev/null 2>&1
      for pkg in $(pm list packages -3 2>/dev/null | cut -d: -f2); do
        case "$pkg" in
          com.topjohnwu.magisk|me.weishu.kernelsu|me.bmax.apatch|com.termux|com.dergoogler.mmrl*) continue ;;
          *) am force-stop "$pkg" >/dev/null 2>&1 ;;
        esac
      done
      cmd activity idle-maintenance >/dev/null 2>&1
      fstrim -v /data >/dev/null 2>&1 || true
      ;;
    custom|5|flush5)
      am kill-all >/dev/null 2>&1
      service call activity 51 i32 "$bg_limit" >/dev/null 2>&1 || true
      ;;
  esac
  sync
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
}

before_mem=$(get_mem_info)
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Starting RAM Flush (Mode: $mode) | Before: $before_mem" | tee -a "$LOGFILE"

bin_cmd=""
case "$mode" in
  safe|1|flush) bin_cmd="flush" ;;
  aggressive|2|flush2) bin_cmd="flush2" ;;
  extreme|3|flush3) bin_cmd="flush3" ;;
  custom|5|flush5) bin_cmd="flush5" ;;
  *) bin_cmd="flush" ;;
esac

# Execute original binary if 32-bit linker exists, then reinforce with native_flush
if [ -e "/system/bin/linker" ] && command -v "$bin_cmd" >/dev/null 2>&1; then
  "$bin_cmd" >/dev/null 2>&1 &
  sleep 1
fi
native_flush "$mode"

after_mem=$(get_mem_info)
msg="RaffOptimizer Flush ($mode) completed! RAM: $after_mem"
echo "[$(date +'%Y-%m-%d %H:%M:%S')] $msg" | tee -a "$LOGFILE"
show_toast "$msg"
