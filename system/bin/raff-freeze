#!/system/bin/sh
# RaffOptimizer - Multi-User APK Freezer & Unfreezer
# Supports freezing/unfreezing apps across all Android users (e.g., User 0, User 10, Work Profile, Clone Apps)

CONFIG_DIR="/data/adb/raffoptimizer/config"
FROZEN_LIST="${CONFIG_DIR}/frozen_apps.list"
LOGFILE="/data/adb/raffoptimizer/run/freeze.log"
mkdir -p "${CONFIG_DIR}" /data/adb/raffoptimizer/run
touch "${FROZEN_LIST}"

get_users() {
  pm list users 2>/dev/null | grep "UserInfo{" | sed -E 's/.*UserInfo\{([0-9]+):.*/\1/'
}

usage() {
  echo "Usage: raff-freeze <command> [package] [--user all|<user_id>]"
  echo "Commands:"
  echo "  users                          - List all User IDs on the device (e.g., 0, 10)"
  echo "  list [--user all|<id>]         - List currently frozen APKs"
  echo "  freeze <pkg> [--user all|<id>] - Freeze an APK for all users or a specific user"
  echo "  unfreeze <pkg> [--user all|<id>] - Unfreeze (re-enable) an APK"
  echo "  unfreeze-all                   - Unfreeze all currently frozen APKs"
}

cmd="$1"
pkg="$2"
target_user="all"

shift 2 2>/dev/null || true
while [ $# -gt 0 ]; do
  case "$1" in
    --user|-u)
      target_user="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$target_user" = "all" ] || [ -z "$target_user" ]; then
  USERS=$(get_users)
  [ -z "$USERS" ] && USERS="0"
else
  USERS="$target_user"
fi

case "$cmd" in
  users)
    for u in $(get_users); do
      echo "User ID: $u"
    done
    ;;
  list)
    for u in $USERS; do
      echo "=== Frozen Packages (User $u) ==="
      pm list packages -d --user "$u" 2>/dev/null | cut -d: -f2 | sort
    done
    ;;
  freeze)
    if [ -z "$pkg" ]; then
      echo "Error: Please specify a package name (e.g., raff-freeze freeze com.facebook.katana --user all)"
      exit 1
    fi
    for u in $USERS; do
      res=$(pm disable-user --user "$u" "$pkg" 2>&1)
      am force-stop --user "$u" "$pkg" >/dev/null 2>&1
      echo "[User $u] $res"
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] FREEZE pkg=$pkg user=$u res=$res" >> "$LOGFILE"
    done
    grep -qxF "$pkg" "$FROZEN_LIST" 2>/dev/null || echo "$pkg" >> "$FROZEN_LIST"
    ;;
  unfreeze)
    if [ -z "$pkg" ]; then
      echo "Error: Please specify a package name (e.g., raff-freeze unfreeze com.facebook.katana --user all)"
      exit 1
    fi
    for u in $USERS; do
      res=$(pm enable --user "$u" "$pkg" 2>&1)
      echo "[User $u] $res"
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] UNFREEZE pkg=$pkg user=$u res=$res" >> "$LOGFILE"
    done
    sed -i "/^${pkg}$/d" "$FROZEN_LIST" 2>/dev/null
    ;;
  unfreeze-all)
    for u in $(get_users); do
      for p in $(pm list packages -d --user "$u" 2>/dev/null | cut -d: -f2); do
        pm enable --user "$u" "$p" >/dev/null 2>&1
        echo "[User $u] Enabled $p"
      done
    done
    > "$FROZEN_LIST"
    ;;
  *)
    usage
    ;;
esac
