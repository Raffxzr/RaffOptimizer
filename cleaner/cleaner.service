#!/system/bin/sh
scripts=$(realpath $0)
scripts_dir=$(dirname ${scripts})
busybox_path="/data/adb/magisk/busybox"
if [ ! -x "${busybox_path}" ]; then
  if [ -x "/data/adb/ksu/bin/busybox" ]; then
    busybox_path="/data/adb/ksu/bin/busybox"
  elif [ -x "/data/adb/ap/bin/busybox" ]; then
    busybox_path="/data/adb/ap/bin/busybox"
  else
    busybox_path="busybox"
  fi
fi

cleaner_run_path="/data/adb/raffoptimizer/run"
mkdir -p "${cleaner_run_path}"
log_cleaner="${cleaner_run_path}/cleaner.log"
cleaner_pid="${cleaner_run_path}/cache.pid"
current_time=$(date +"%I:%M %P")

PROPFILE="/data/adb/modules/RaffOptimizer/module.prop"
schedule_cleaner="0 */6 * * *"

log() {
  if [ "$1" = "info" ]; then
    [ -t 1 ] && echo -e "\033[1;33m${current_time} [info]: $2\033[0m"
  else
    [ -t 1 ] && echo -e "\033[1;30m${current_time} [$1]: $2\033[0m"
  fi
  echo "${current_time} [$1]: $2" >> "${log_cleaner}" 2>/dev/null
}

calc_total_cache() {
  local sum=0
  local s=0
  for d in "/data/data/*/cache" "/data/data/*/code_cache" "/data/user_de/*/*/cache" "/data/user_de/*/*/code_cache" "/sdcard/Android/data/*/cache" "/data/system/dropbox"; do
    s=$(du -cs $d 2>/dev/null | grep total | cut -f 1 | head -n 1)
    [ -z "$s" ] && s=0
    sum=$(( sum + s ))
  done
  echo "$sum"
}

run_cleaner() {
  local total=0
  local size=0
  for dir in "/data/data/*/cache/*" "/data/data/*/code_cache/*" "/data/user_de/*/*/cache/*" "/data/user_de/*/*/code_cache/*" "/sdcard/Android/data/*/cache/*" "/data/system/dropbox/*"; do
    size=$(du -cs $dir 2>/dev/null | grep total | cut -f 1 | head -n 1)
    [ -z "$size" ] && size=0
    total=$(( total + size ))
    log debug "$dir >>>>> ${size} KB"
    find $dir/* -delete >/dev/null 2>&1
  done
  log info "Cache cleaning is complete."
}

run_auto() {
  echo "$(date)" > "${log_cleaner}"
  total=$(calc_total_cache)
  [ -z "$total" ] && total=0

  if [ "${total}" -ge 1024 ]; then
    total_cache="$(( total / 1024 )) MB"
  else
    total_cache="${total} KB"
  fi

  escaped_total_cache=$(printf '%s\n' "${total_cache}" | sed -e 's/[\/&]/\\&/g')
  log info "Total Cache: ${total_cache}"

  size_cache=1024000 # 1GB threshold in KB (configurable)
  if [ -f "/data/adb/raffoptimizer/config/cache_limit_kb" ]; then
    custom_limit=$(cat /data/adb/raffoptimizer/config/cache_limit_kb 2>/dev/null)
    [ -n "$custom_limit" ] && size_cache="$custom_limit"
  fi

  if [ "$total" -gt "$size_cache" ]; then
    log info "Cleaning apps cache (exceeded ${size_cache} KB)..."
    run_cleaner
    log info "Done! The apps cache has been cleaned!"
    [ -f "$PROPFILE" ] && sed -Ei "s/^description=.*/description=[ $current_time | Auto-Cleaned: ${escaped_total_cache} ] All-in-One Android Optimizer by Raffxzr/g" "$PROPFILE"
  else
    log info "Skip auto-cleaning! Cache size (${total_cache}) is below threshold (${size_cache} KB)"
    [ -f "$PROPFILE" ] && sed -Ei "s/^description=.*/description=[ $current_time | Cache: ${escaped_total_cache} (Standby) ] All-in-One Android Optimizer by Raffxzr/g" "$PROPFILE"
  fi
}

run_crond() {
  ulimit -SHn 1000000 2>/dev/null
  nohup "${busybox_path}" crond -c "${cleaner_run_path}" > /dev/null 2>&1 &
  PID=$!
  echo -n $PID > "${cleaner_pid}"

  "${busybox_path}" crontab -c "${cleaner_run_path}" -r 2>/dev/null
  touch "${cleaner_run_path}/root"
  chmod 0600 "${cleaner_run_path}/root"

  if echo "${schedule_cleaner} ${scripts_dir}/cleaner.service auto" >> "${cleaner_run_path}/root"; then
    log info "Scheduled Auto Cache Cleaner (${schedule_cleaner})"
  fi
}

display_pid() {
  local PID
  PID=$(ps -ef 2>/dev/null | grep "crond -c /data/adb/raffoptimizer/run" | grep -v grep | awk '{print $2}' | head -n 1)
  if [ -n "$PID" ]; then
    echo "$PID" > "${cleaner_pid}"
    log info "Cache Cleaner service is running (PID: $PID)"
  else
    log error "Cache Cleaner service is not running"
  fi
}

start_cleaner() {
  run_auto
  run_crond
  display_pid
}

stop_cleaner() {
  local PID
  PID=$(ps -ef 2>/dev/null | grep "crond -c /data/adb/raffoptimizer/run" | grep -v grep | awk '{print $2}')
  if [ -n "$PID" ]; then
    kill -15 $PID 2>/dev/null
    rm -f "${cleaner_pid}"
    log info "Cache Cleaner stopped (PID: $PID)"
  else
    log error "Cache Cleaner is not running"
  fi
}

case "$1" in
  start)
    stop_cleaner
    start_cleaner
    ;;
  stop)
    stop_cleaner
    ;;
  auto)
    run_auto
    ;;
  status)
    display_pid
    ;;
  *)
    echo "Usage: $0 {start|stop|auto|status}"
    ;;
esac
