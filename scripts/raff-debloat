#!/system/bin/sh
# RaffOptimizer - System & User APK Remover / Debloater
# Supports Multi-User PM Uninstall + Magisk Systemless Replacement (.replace) & Restore

MODDIR="/data/adb/modules/RaffOptimizer"
CONFIG_DIR="/data/adb/raffoptimizer/config"
DEBLOAT_LIST="${CONFIG_DIR}/debloated_apps.list"
LOGFILE="/data/adb/raffoptimizer/run/debloat.log"
mkdir -p "${CONFIG_DIR}" /data/adb/raffoptimizer/run
touch "${DEBLOAT_LIST}"

get_users() {
  pm list users 2>/dev/null | grep "UserInfo{" | sed -E 's/.*UserInfo\{([0-9]+):.*/\1/'
}

usage() {
  echo "Usage: raff-debloat <command> [package] [--user all|<user_id>] [--systemless]"
  echo "Commands:"
  echo "  list-system                    - List all pre-installed System APKs"
  echo "  list-user                      - List all user-installed APKs"
  echo "  list-removed                   - List all debloated/removed APKs"
  echo "  remove <pkg> [--user all|<id>] [--systemless]"
  echo "                                 - Remove an APK (System or User). Use --systemless"
  echo "                                   to mask system APK folder via Magisk .replace"
  echo "  restore <pkg> [--user all|<id>]- Restore a previously removed APK"
}

cmd="$1"
pkg="$2"
target_user="all"
systemless="false"

shift 2 2>/dev/null || true
while [ $# -gt 0 ]; do
  case "$1" in
    --user|-u)
      target_user="$2"
      shift 2
      ;;
    --systemless|-s)
      systemless="true"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$target_user" = "all" ] || [ -z "$target_user" ]; then
  USERS=$(get_users)
  [ -z "$USERS" ] && USERS="0"
else
  USERS="$target_user"
fi

apply_systemless_replace() {
  local package="$1"
  local apk_path
  apk_path=$(pm path "$package" 2>/dev/null | head -n 1 | cut -d: -f2)
  [ -z "$apk_path" ] && return 1
  local apk_dir
  apk_dir=$(dirname "$apk_path")

  case "$apk_dir" in
    /system/*)
      mkdir -p "${MODDIR}${apk_dir}"
      touch "${MODDIR}${apk_dir}/.replace"
      echo "Systemless replacement created at: ${MODDIR}${apk_dir}/.replace"
      return 0
      ;;
    /product/*|/vendor/*|/system_ext/*)
      mkdir -p "${MODDIR}/system${apk_dir}"
      touch "${MODDIR}/system${apk_dir}/.replace"
      echo "Systemless replacement created at: ${MODDIR}/system${apk_dir}/.replace"
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

case "$cmd" in
  list-system)
    pm list packages -s --user 0 2>/dev/null | cut -d: -f2 | sort
    ;;
  list-user)
    pm list packages -3 --user 0 2>/dev/null | cut -d: -f2 | sort
    ;;
  list-removed)
    cat "$DEBLOAT_LIST" 2>/dev/null
    ;;
  remove)
    if [ -z "$pkg" ]; then
      echo "Error: Please specify a package name to remove!"
      exit 1
    fi
    # Check if system app
    is_sys=$(pm list packages -s --user 0 2>/dev/null | grep -qxF "package:${pkg}" && echo "yes" || echo "no")
    apk_path=$(pm path "$pkg" 2>/dev/null | head -n 1 | cut -d: -f2)

    if [ "$systemless" = "true" ] && [ "$is_sys" = "yes" ]; then
      apply_systemless_replace "$pkg"
    fi

    for u in $USERS; do
      if [ "$is_sys" = "yes" ]; then
        res=$(pm uninstall -k --user "$u" "$pkg" 2>&1)
      else
        res=$(pm uninstall --user "$u" "$pkg" 2>&1)
      fi
      echo "[User $u] Remove $pkg (system=$is_sys): $res"
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] REMOVE pkg=$pkg sys=$is_sys user=$u path=$apk_path res=$res" >> "$LOGFILE"
    done
    grep -q "^${pkg}|" "$DEBLOAT_LIST" 2>/dev/null || echo "${pkg}|${is_sys}|${apk_path}" >> "$DEBLOAT_LIST"
    ;;
  restore)
    if [ -z "$pkg" ]; then
      echo "Error: Please specify a package name to restore!"
      exit 1
    fi
    # Remove any Magisk .replace directory if present
    saved_line=$(grep "^${pkg}|" "$DEBLOAT_LIST" 2>/dev/null | head -n 1)
    saved_path=$(echo "$saved_line" | cut -d'|' -f3)
    if [ -n "$saved_path" ]; then
      saved_dir=$(dirname "$saved_path")
      rm -rf "${MODDIR}${saved_dir}" "${MODDIR}/system${saved_dir}" 2>/dev/null
    fi
    for u in $USERS; do
      res=$(cmd package install-existing --user "$u" "$pkg" 2>&1)
      pm enable --user "$u" "$pkg" >/dev/null 2>&1
      echo "[User $u] Restore $pkg: $res"
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] RESTORE pkg=$pkg user=$u res=$res" >> "$LOGFILE"
    done
    sed -i "/^${pkg}|/d" "$DEBLOAT_LIST" 2>/dev/null
    ;;
  *)
    usage
    ;;
esac
